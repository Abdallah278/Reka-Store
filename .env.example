# =============================================================================
# Reka Store — environment (Supabase + Vercel)
# Set these in Vercel → Project → Settings → Environment Variables for
# production, and in a local .env for development. Never commit real values.
# =============================================================================

# ---- Supabase (required) ----------------------------------------------------
# Project URL + anon key: Supabase Dashboard → Project Settings → API.
# The VITE_ pair is embedded in the frontends (anon key is public by design).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side mirrors (optional; the server falls back to the VITE_ values).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVICE ROLE KEY — SERVER ONLY. Never expose to the browser or client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for product/brand images (create it as a PUBLIC bucket).
SUPABASE_STORAGE_BUCKET=product-images

# ---- Database (required) ----------------------------------------------------
# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooled (transaction) connection string for serverless.
DATABASE_URL=

# ---- Owner allowlist (required for the console) -----------------------------
# Comma-separated Supabase Auth user ids (UUIDs) allowed into the owner
# console. Anyone not listed is FORBIDDEN even if their DB row says "admin".
# Empty list = every private procedure fails closed.
OWNER_SUPABASE_USER_IDS=

# ---- Store defaults ---------------------------------------------------------
# Fallback WhatsApp number (digits, with country code) used until store
# settings are saved from the console.
STORE_WHATSAPP_NUMBER=

# ---- Rate limiting (recommended for production) -----------------------------
# Upstash Redis REST credentials; shared limits across serverless instances.
# Without them the limiter is in-memory per instance (dev only; logged).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Hostname split ---------------------------------------------------------
# Leave ADMIN_HOSTNAME empty => single-host mode, console under /manage.
# Set it (second Vercel project / domain) => console served ONLY on that host.
ADMIN_HOSTNAME=
PUBLIC_HOSTNAME=
# Extra origins allowed to call the API with credentials (split-origin only).
CORS_ALLOWLIST=

# ---- Headers / uploads ------------------------------------------------------
FRAME_ANCESTORS='none'
MAX_UPLOAD_BYTES=5242880

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=3000
