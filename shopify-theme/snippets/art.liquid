{%- when 'droplets' -%}
<svg viewBox="0 0 400 500" role="img" aria-label="{{ t | escape }}" preserveAspectRatio="xMidYMid slice">
  <rect width="400" height="500" fill="#fbf4d6"/>
  <defs>
    <radialGradient id="dp-g" cx=".35" cy=".3" r=".9"><stop offset="0" stop-color="#fff" stop-opacity=".9"/><stop offset=".6" stop-color="#F4E382" stop-opacity=".3"/><stop offset="1" stop-color="#74070E" stop-opacity=".25"/></radialGradient>
  </defs>
  {%- for i in (0..27) -%}
    {%- assign x = i | times: 97 | modulo: 330 | plus: 40 -%}
    {%- assign y = i | times: 61 | modulo: 430 | plus: 40 -%}
    {%- assign r = i | times: 13 | modulo: 22 | plus: 8 -%}
    {%- assign hx = r | divided_by: 3.0 -%}{%- assign hcx = x | minus: hx -%}{%- assign hcy = y | minus: hx -%}
    {%- assign hr = r | divided_by: 5.0 | at_least: 2 -%}
    <circle cx="{{ x }}" cy="{{ y }}" r="{{ r }}" fill="url(#dp-g)" stroke="#947268" stroke-opacity=".28"/>
    <circle cx="{{ hcx }}" cy="{{ hcy }}" r="{{ hr }}" fill="#fff" opacity=".85"/>
  {%- endfor -%}
  <path d="M0 430 q100 -40 200 0 t200 0 v70 h-400z" fill="#74070E" opacity=".16"/>
</svg>

