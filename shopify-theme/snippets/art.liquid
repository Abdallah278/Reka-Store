{%- when 'mist' -%}
<svg viewBox="0 0 400 500" role="img" aria-label="{{ t | escape }}" preserveAspectRatio="xMidYMid slice">
  <rect width="400" height="500" fill="#310E10"/>
  {%- for i in (0..21) -%}
    {%- assign x = i | times: 83 | modulo: 340 | plus: 30 -%}
    {%- assign y = i | times: 107 | modulo: 420 | plus: 40 -%}
    {%- assign r = i | times: 17 | modulo: 40 | plus: 6 -%}
    {%- assign m3 = i | modulo: 3 -%}
    {%- assign m4 = i | modulo: 4 | times: 0.06 | plus: 0.12 -%}
    <circle cx="{{ x }}" cy="{{ y }}" r="{{ r }}" fill="{% if m3 == 0 %}#F4E3B2{% else %}#947268{% endif %}" opacity="{{ m4 }}"/>
  {%- endfor -%}
  <path d="M-20 380 q120 -80 220 -20 t220 -30" stroke="#F4E382" stroke-opacity=".25" stroke-width="10" fill="none" stroke-linecap="round"/>
</svg>

{%- when 'offer-mark' -%}
<svg viewBox="0 0 400 500" role="img" aria-label="{{ t | escape }}" preserveAspectRatio="xMidYMid slice">
  <rect width="400" height="500" fill="#310E10"/>
  <circle cx="320" cy="80" r="90" fill="#74070E" opacity=".5"/>
  <circle cx="60" cy="440" r="70" fill="#947268" opacity=".25"/>
  <g font-family="Georgia, serif" font-weight="700">
    <text x="52" y="250" font-size="180" fill="#F4E382">%</text>
    <text x="60" y="360" font-size="54" fill="#F4E3B2" opacity=".9">honest</text>
    <text x="60" y="420" font-size="54" fill="#947268">offers</text>
  </g>
  <rect x="52" y="270" width="180" height="8" rx="4" fill="#74070E"/>
</svg>

{%- endcase -%}
{%- endif -%}
