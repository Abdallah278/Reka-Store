    {%- assign lx = i | times: 40 | plus: 70 -%}{%- assign ly = 345 | minus: i | minus: i | minus: i | minus: i | minus: i | minus: i | minus: i | minus: i | minus: i | minus: i | minus: i | minus: i -%}
