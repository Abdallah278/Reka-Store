[
  {
    "name": "theme_info",
    "theme_name": "Reka Store",
    "theme_version": "1.0.0",
    "theme_author": "Reka Store",
    "theme_documentation_url": "https://github.com/Abdallah278/Reka-Store",
    "theme_support_url": "https://github.com/Abdallah278/Reka-Store"
  },
  {
    "name": "Store identity",
    "settings": [
      { "type": "text", "id": "store_name", "label": "Store display name", "default": "Reka Store" },
      { "type": "image_picker", "id": "logo_image", "label": "Logo (round, replaces the R mark)" },
      { "type": "text", "id": "instagram_url", "label": "Instagram profile URL" },
      { "type": "text", "id": "facebook_url", "label": "Facebook page URL" },
      { "type": "text", "id": "tiktok_url", "label": "TikTok profile URL" },
      { "type": "text", "id": "whatsapp_page_url", "label": "WhatsApp business/channel page URL (optional — falls back to the number)" }
    ]
  },
  {
    "name": "WhatsApp ordering",
    "settings": [
      { "type": "text", "id": "whatsapp_number", "label": "Store WhatsApp number (digits only, e.g. 2010xxxxxxxx)", "default": "201094881552" },
      { "type": "range", "id": "delivery_fee", "label": "Flat delivery fee (EGP, 0 = confirmed in chat) — used only when no shipping zones are set", "min": 0, "max": 500, "step": 5, "default": 0 }
    ]
  },
  {
    "name": "Shipping zones",
    "settings": [
      { "type": "paragraph", "content": "One zone per line, format: Governorate | fee in EGP | delivery time. Example: Cairo | 70 | 1–2 days. Leave empty to keep everything \"confirmed on WhatsApp\". Fee or time can be left blank inside a line (e.g. Aswan | | 3–5 days)." },
      { "type": "textarea", "id": "shipping_zones", "label": "Zones (Governorate | fee | delivery time)" },
      { "type": "text", "id": "free_shipping_threshold", "label": "Free delivery above (EGP) — empty = disabled" },
      { "type": "textarea", "id": "shipping_extra_note", "label": "Extra note shown on the Shipping page (optional)" }
    ]
  }
]
