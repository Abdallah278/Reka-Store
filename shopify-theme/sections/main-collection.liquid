{%- comment -%}
  Department page — exact port of DepartmentPage.tsx + departments.tsx.
  Renders the five departments (korean-skincare, french-skincare, makeup,
  perfumes, offers) each with its own colour identity, artwork, motion,
  ritual and editorial content. Any other collection uses the makeup identity.
  Order: DeptHero → (perfumes scroll bottle) → Collection grid → Ritual →
  Editorial → WhatsApp CTA.
{%- endcomment -%}
{%- assign h = collection.handle -%}
{%- assign is_offers = false -%}{%- if h == 'offers' -%}{%- assign is_offers = true -%}{%- endif -%}
{%- assign dark = true -%}
{%- case h -%}
  {%- when 'korean-skincare' -%}
    {%- assign dept_color = '#74070E' -%}
    {%- assign dept_key = 'korean' -%}
    {%- assign grad = 'linear-gradient(160deg, #74070E 0%, #310E10 78%)' -%}
    {%- assign hero_art = 'serum-bottle' -%}{%- assign motif_art = 'droplets' -%}{%- assign motif_anim = 'anim-float' -%}
    {%- assign cats = 'Cleansers,Toners,Serums,Masks,Moisturizers' | split: ',' -%}
    {%- assign e1a = 'droplets' -%}{%- assign e2a = 'hands' -%}
  {%- when 'french-skincare' -%}
    {%- assign dark = false -%}
    {%- assign dept_color = '#F4E3B2' -%}
    {%- assign dept_key = 'french' -%}
    {%- assign grad = 'linear-gradient(160deg, #F4E3B2 0%, #fbf4d6 70%)' -%}
    {%- assign hero_art = 'cream-jar' -%}{%- assign motif_art = 'silk' -%}{%- assign motif_anim = 'anim-drift' -%}
    {%- assign cats = 'Cleansing,Hydration,Body Care,Treatments,Sets' | split: ',' -%}
    {%- assign e1a = 'silk' -%}{%- assign e2a = 'portrait' -%}
  {%- when 'perfumes' -%}
    {%- assign dept_color = '#947268' -%}
    {%- assign dept_key = 'perfumes' -%}
    {%- assign grad = 'linear-gradient(160deg, #947268 0%, #310E10 85%)' -%}
    {%- assign hero_art = 'perfume-bottle' -%}{%- assign motif_art = 'mist' -%}{%- assign motif_anim = 'anim-float-slow' -%}
    {%- assign cats = 'Women,Unisex,Fresh,Floral,Woody,Gift Sets' | split: ',' -%}
    {%- assign e1a = 'mist' -%}{%- assign e2a = 'botanical' -%}
  {%- when 'offers' -%}
    {%- assign dept_color = '#310E10' -%}
    {%- assign dept_key = 'offers' -%}
    {%- assign grad = 'linear-gradient(165deg, #310E10 0%, #74070E 130%)' -%}
    {%- assign hero_art = 'offer-mark' -%}{%- assign motif_art = 'vanity' -%}{%- assign motif_anim = 'anim-rise' -%}
    {%- assign cats = '' | split: ',' -%}
    {%- assign e1a = 'eye' -%}{%- assign e2a = 'vanity' -%}
  {%- else -%}
    {%- assign dept_color = '#45462A' -%}
    {%- assign dept_key = 'makeup' -%}
    {%- assign grad = 'linear-gradient(160deg, #45462A 0%, #310E10 80%)' -%}
    {%- assign hero_art = 'lipstick-bullet' -%}{%- assign motif_art = 'palette-quad' -%}{%- assign motif_anim = 'anim-tilt-sway' -%}
    {%- assign cats = 'Lips,Face,Eyes,Brushes,Palettes' | split: ',' -%}
    {%- assign e1a = 'texture' -%}{%- assign e2a = 'brush' -%}
{%- endcase -%}

{%- comment -%} All department copy comes from the locale files (en.default.json /
    ar.json) so the whole page translates. Base = 'depts.<key>.' {%- endcomment -%}
{%- assign tbase = 'depts.' | append: dept_key | append: '.' -%}
{%- assign k = tbase | append: 'name' -%}{%- assign dept_name = k | t -%}
{%- assign k = tbase | append: 'short' -%}{%- assign dept_short = k | t -%}
{%- assign k = tbase | append: 'eyebrow' -%}{%- assign eyebrow = k | t -%}
{%- assign k = tbase | append: 'tagline' -%}{%- assign tagline = k | t -%}
{%- assign k = tbase | append: 'intro' -%}{%- assign intro = k | t -%}
{%- assign k = tbase | append: 'ritual_title' -%}{%- assign ritual_title = k | t -%}
{%- assign k = tbase | append: 'r1t' -%}{%- assign r1t = k | t -%}
{%- assign k = tbase | append: 'r1x' -%}{%- assign r1x = k | t -%}
{%- assign k = tbase | append: 'r2t' -%}{%- assign r2t = k | t -%}
{%- assign k = tbase | append: 'r2x' -%}{%- assign r2x = k | t -%}
{%- assign k = tbase | append: 'r3t' -%}{%- assign r3t = k | t -%}
{%- assign k = tbase | append: 'r3x' -%}{%- assign r3x = k | t -%}
{%- assign k = tbase | append: 'e1e' -%}{%- assign e1e = k | t -%}
{%- assign k = tbase | append: 'e1t' -%}{%- assign e1t = k | t -%}
{%- assign k = tbase | append: 'e1x' -%}{%- assign e1x = k | t -%}
{%- assign k = tbase | append: 'e2e' -%}{%- assign e2e = k | t -%}
{%- assign k = tbase | append: 'e2t' -%}{%- assign e2t = k | t -%}
{%- assign k = tbase | append: 'e2x' -%}{%- assign e2x = k | t -%}
{%- if h != 'korean-skincare' and h != 'french-skincare' and h != 'makeup' and h != 'perfumes' and h != 'offers' -%}
  {%- assign dept_name = collection.title -%}{%- assign dept_short = collection.title | downcase -%}
{%- endif -%}

{%- comment -%}
  Admin overrides — everything below can be changed per collection from
  Shopify Admin without touching code:
  • Collection title      → department name
  • Collection description→ hero intro text
  • Collection image      → hero artwork (replaces the illustration)
  • Metafields (namespace "reka"): eyebrow, tagline, color (hex) — need
    metafield definitions once (Settings → Custom data → Collections).
{%- endcomment -%}
{%- if collection.title != blank -%}{%- assign dept_name = collection.title -%}{%- endif -%}
{%- assign desc_override = collection.description | strip_html | strip -%}
{%- if desc_override != blank -%}{%- assign intro = desc_override -%}{%- endif -%}
{%- if collection.metafields.reka.eyebrow.value != blank -%}{%- assign eyebrow = collection.metafields.reka.eyebrow.value -%}{%- endif -%}
{%- if collection.metafields.reka.tagline.value != blank -%}{%- assign tagline = collection.metafields.reka.tagline.value -%}{%- endif -%}
{%- if collection.metafields.reka.color.value != blank -%}
  {%- assign dept_color = collection.metafields.reka.color.value -%}
  {%- assign grad = 'linear-gradient(160deg, ' | append: dept_color | append: ' 0%, #310E10 80%)' -%}
{%- endif -%}

{%- assign wa = settings.whatsapp_number | default: '201000000000' -%}
{%- assign store_name = settings.store_name | default: 'Reka Store' -%}
{%- assign count = collection.products_count -%}
{%- if dark -%}
  {%- assign fg = 'var(--canvas)' -%}
  {%- assign fg75 = 'color-mix(in srgb, var(--canvas) 75%, transparent)' -%}
  {%- assign fg80 = 'color-mix(in srgb, var(--canvas) 80%, transparent)' -%}
{%- else -%}
  {%- assign fg = 'var(--ink)' -%}
  {%- assign fg75 = 'color-mix(in srgb, var(--ink) 70%, transparent)' -%}
  {%- assign fg80 = 'color-mix(in srgb, var(--ink) 70%, transparent)' -%}
{%- endif -%}

<div style="--dept: {{ dept_color }};">

{%- comment -%} ---- DeptHero (exact port) ---- {%- endcomment -%}
<section class="rk-dhero" aria-labelledby="dept-title">
  <div class="rk-dhero__panel" style="background: {{ grad }};">
    <div class="rk-dhero__ripple anim-ripple" aria-hidden="true"></div>
    <div class="rk-dhero__grid" style="color: {{ fg }};">
      <div>
        <p class="eyebrow rk-dhero__eyebrow" style="border-color: color-mix(in srgb, {{ fg }} 25%, transparent); background: color-mix(in srgb, {{ fg }} 16%, transparent); color: {{ fg }};">
          {% render 'icon', name: 'sparkles' %} {{ eyebrow }}
        </p>
        <h1 id="dept-title" class="rk-dhero__title font-display">{{ dept_name }}</h1>
        <p class="rk-dhero__tagline font-display" style="color: {{ fg80 }};">{{ tagline }}</p>
        <p class="rk-dhero__intro" style="color: {{ fg75 }};">{{ intro }}</p>
        <div class="rk-dhero__ctas">
          <a href="#collection" class="rk-pillbtn {% if dark %}rk-pillbtn--canvas{% else %}rk-pillbtn--ink{% endif %}">
            {{ 'shared.browse' | t }} {% if count > 0 %}{% if count == 1 %}{{ 'shared.piece' | t: count: count }}{% else %}{{ 'shared.pieces' | t: count: count }}{% endif %}{% else %}{{ 'shared.the_edit' | t }}{% endif %}
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>
          <a href="https://wa.me/{{ wa }}?text={{ 'Hi ' | append: store_name | append: ', tell me about ' | append: dept_name | append: '.' | url_encode }}" target="_blank" rel="noopener noreferrer" class="rk-pillbtn rk-pillbtn--ghost" style="border-color: color-mix(in srgb, {{ fg }} 40%, transparent);">
            {% render 'icon', name: 'message-circle' %} {{ 'shared.whatsapp' | t }}
          </a>
        </div>
        {%- if cats.size > 0 -%}
        <ul class="rk-dhero__cats" aria-label="{{ dept_name }} categories">
          {%- for c in cats -%}
            <li style="border-color: color-mix(in srgb, {{ fg }} 35%, transparent); background: color-mix(in srgb, {{ fg }} 8%, transparent); color: {{ fg }};">{{ c }}</li>
          {%- endfor -%}
        </ul>
        {%- endif -%}
      </div>
      <div class="rk-dhero__artcol">
        <div class="rk-dhero__artframe {% if h == 'french-skincare' %}anim-sheen{% endif %}" style="--ring: color-mix(in srgb, {{ fg }} 18%, transparent);">
          <div class="{{ motif_anim }}" style="height:100%; width:100%;">
            {%- assign known_depts = 'korean-skincare,french-skincare,makeup,perfumes,offers' | split: ',' -%}
            {%- if collection.image -%}
              <img src="{{ collection.image | image_url: width: 900 }}" alt="{{ dept_name | escape }}" loading="lazy" width="{{ collection.image.width }}" height="{{ collection.image.height }}" style="height:100%; width:100%; object-fit:cover; border-radius:inherit;">
            {%- elsif known_depts contains h -%}
              <img src="{{ 'dept-' | append: h | append: '.jpg' | asset_url }}" alt="{{ dept_name | escape }}" loading="eager" width="900" height="700" style="height:100%; width:100%; object-fit:cover; border-radius:inherit;">
            {%- else -%}
              {% render 'art', key: hero_art, title: dept_name %}
            {%- endif -%}
          </div>
        </div>
        <div class="rk-dhero__motif" style="background: {% if dark %}var(--canvas){% else %}var(--ink){% endif %};">
          <div class="rk-dhero__motif-inner">{% render 'art', key: motif_art, title: dept_name %}</div>
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ---- Perfume scroll bottle (decorative, lg only) ---- {%- endcomment -%}
{%- if h == 'perfumes' -%}
<div aria-hidden="true" class="rk-scrollbottle" data-scroll-bottle>
  <div class="rk-scrollbottle__bottle" data-scroll-bottle-el>
    <svg viewBox="0 0 160 220" style="width:100%;">
      <polygon points="40,70 120,70 140,110 140,190 20,190 20,110" fill="#947268"/>
      <polygon points="40,70 80,70 80,190 20,190 20,110" fill="#F4E3B2" opacity=".3"/>
      <rect x="58" y="38" width="44" height="34" rx="6" fill="#310E10"/>
      <rect x="68" y="14" width="24" height="28" rx="8" fill="#F4E3B2"/>
    </svg>
  </div>
  <div class="rk-scrollbottle__note" style="left:12%;" data-note-at=".25"><p class="eyebrow text-burgundy">Top notes</p><p class="font-display" style="margin-top:.25rem; font-size:1.25rem; color:var(--ink);">Bergamot · pink pepper</p></div>
  <div class="rk-scrollbottle__note" style="left:44%;" data-note-at=".5"><p class="eyebrow text-burgundy">Heart notes</p><p class="font-display" style="margin-top:.25rem; font-size:1.25rem; color:var(--ink);">Rose · orris · clay musk</p></div>
  <div class="rk-scrollbottle__note" style="left:76%;" data-note-at=".75"><p class="eyebrow text-burgundy">Base notes</p><p class="font-display" style="margin-top:.25rem; font-size:1.25rem; color:var(--ink);">Amber · cedar · deep ink</p></div>
</div>
{%- endif -%}

{%- comment -%} ---- Collection grid ---- {%- endcomment -%}
<section id="collection" class="rk-collection {% if is_offers %}rk-collection--dark{% endif %}" style="scroll-margin-top:6rem;" aria-labelledby="collection-title">
  <div class="container">
    <div class="rk-split">
      <div class="rk-section-head {% if is_offers %}rk-section-head--dark{% endif %}">
        <p class="eyebrow {% unless is_offers %}text-burgundy{% endunless %}">{% if is_offers %}{{ section.settings.offers_eyebrow | default: 'Active offers' }}{% else %}{{ section.settings.grid_eyebrow | default: 'The collection' }}{% endif %}</p>
        <h2 id="collection-title" class="font-display">{% if is_offers %}{{ section.settings.offers_title | default: 'On offer right now' }}{% else %}{{ 'shared.edit_title' | t: name: dept_short }}{% endif %}</h2>
      </div>
      {%- comment -%} Category filter chips — categories = Shopify product types present {%- endcomment -%}
      <div role="group" aria-label="Filter by category" class="rk-catchips no-scrollbar" data-cat-filter {% if is_offers %}data-dark{% endif %} hidden>
        <button type="button" aria-pressed="true" data-cat="All">All</button>
        {%- assign present = collection.products | map: 'type' | uniq -%}
        {%- for c in cats -%}{%- if present contains c -%}<button type="button" aria-pressed="false" data-cat="{{ c | escape }}">{{ c }}</button>{%- endif -%}{%- endfor -%}
        {%- for p in present -%}
          {%- if p != blank and p != 'Uncategorised' -%}
            {%- unless cats contains p -%}<button type="button" aria-pressed="false" data-cat="{{ p | escape }}">{{ p }}</button>{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if count == 0 -%}
      <div class="rk-empty {% if is_offers %}rk-empty--dark{% endif %}">
        <p class="rk-empty__title font-display">Nothing here yet</p>
        <p>
          {%- if is_offers -%}
            No offers are running at the moment — and we won't invent one. Check back soon or browse the departments at full price.
          {%- else -%}
            The {{ dept_name }} edit is being curated. Ask us on WhatsApp and we'll tell you what's coming.
          {%- endif -%}
        </p>
        <a href="{{ routes.root_url }}" class="{% if is_offers %}rk-pillbtn rk-pillbtn--canvas{% else %}btn-ink{% endif %}">Back to the homepage {% render 'icon', name: 'arrow-up-right' %}</a>
      </div>
    {%- else -%}
      {%- paginate collection.products by 24 -%}
        <ul class="rk-grid-products" aria-label="{{ count }} products" data-cat-grid>
          {%- for product in collection.products -%}
            {%- assign d = forloop.index0 | at_most: 8 | times: 70 -%}
            <li class="anim-rise" style="animation-delay: {{ d }}ms;" data-cat-item="{{ product.type | default: 'Uncategorised' | escape }}">
              {% render 'product-card', product: product, tone_dark: is_offers, show_department: is_offers, idx: forloop.index %}
            </li>
          {%- endfor -%}
        </ul>
        <p class="rk-catchips__none" data-cat-none hidden>
          <span class="rk-empty {% if is_offers %}rk-empty--dark{% endif %}" style="display:block;">Nothing in this category yet. Try another chip.</span>
        </p>
        {%- if paginate.pages > 1 -%}
          <nav style="margin-top:2.5rem; display:flex; justify-content:center; gap:.75rem;" aria-label="Pagination">
            {%- if paginate.previous -%}<a class="btn-outline {% if is_offers %}btn-outline--light{% endif %}" href="{{ paginate.previous.url }}">← Previous</a>{%- endif -%}
            {%- if paginate.next -%}<a class="btn-outline {% if is_offers %}btn-outline--light{% endif %}" href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{%- comment -%} ---- Ritual (exact port) ---- {%- endcomment -%}
<section class="container rk-section" aria-labelledby="ritual-title">
  <div class="rk-section-head">
    <p class="eyebrow text-burgundy">{{ dept_name }}</p>
    <h2 id="ritual-title" class="font-display">{{ ritual_title }}</h2>
  </div>
  <ol class="rk-steps" style="margin-top:2.5rem;">
    <li class="rk-step"><span class="rk-step__bignum font-display">01</span><h3 class="font-display">{{ r1t }}</h3><p>{{ r1x }}</p></li>
    <li class="rk-step"><span class="rk-step__bignum font-display">02</span><h3 class="font-display">{{ r2t }}</h3><p>{{ r2x }}</p></li>
    <li class="rk-step"><span class="rk-step__bignum font-display">03</span><h3 class="font-display">{{ r3t }}</h3><p>{{ r3x }}</p></li>
  </ol>
  <p style="margin-top:1rem; font-size:.75rem; color:var(--olive);">General care notes only — not medical advice.</p>
</section>

{%- comment -%} ---- Editorial (exact port) ---- {%- endcomment -%}
<section class="container" style="padding-bottom:1rem;" aria-label="{{ dept_name }} editorial">
  <div class="rk-editorial">
    <article class="rk-edcard">
      <div class="brand-tone rk-edcard__art">{% render 'art', key: e1a, title: e1t %}</div>
      <div class="rk-edcard__meta">
        <p class="eyebrow">{{ e1e }}</p>
        <h3 class="font-display">{{ e1t }}</h3>
        <p>{{ e1x }}</p>
      </div>
    </article>
    <article class="rk-edcard">
      <div class="brand-tone rk-edcard__art">{% render 'art', key: e2a, title: e2t %}</div>
      <div class="rk-edcard__meta">
        <p class="eyebrow">{{ e2e }}</p>
        <h3 class="font-display">{{ e2t }}</h3>
        <p>{{ e2x }}</p>
      </div>
    </article>
  </div>
</section>

{%- comment -%} ---- WhatsApp CTA (exact port) ---- {%- endcomment -%}
<section class="container" style="padding-bottom:3.5rem;">
  <div class="rk-dcta" style="background: {{ grad }};">
    <div class="rk-dcta__blob" aria-hidden="true"></div>
    <div class="rk-dcta__row" style="color: {{ fg }};">
      <div>
        <p class="eyebrow" style="color: {% if dark %}color-mix(in srgb, var(--canvas) 70%, transparent){% else %}color-mix(in srgb, var(--ink) 60%, transparent){% endif %};">{{ dept_name }}</p>
        <h2 class="font-display">{{ section.settings.cta_title | default: 'Not sure where to start? Just ask.' }}</h2>
      </div>
      <a href="https://wa.me/{{ wa }}?text={{ 'Hi ' | append: store_name | append: ', I would love a ' | append: dept_name | append: ' recommendation.' | url_encode }}" target="_blank" rel="noopener noreferrer" class="rk-pillbtn {% if dark %}rk-pillbtn--canvas{% else %}rk-pillbtn--ink{% endif %}">
        {% render 'icon', name: 'message-circle' %} {{ section.settings.cta_label | default: 'Ask on WhatsApp' }}
      </a>
    </div>
  </div>
</section>

</div>

{% schema %}
{
  "name": "Department page",
  "settings": [
    { "type": "text", "id": "grid_eyebrow", "label": "Grid eyebrow (normal departments)", "default": "The collection" },
    { "type": "text", "id": "offers_eyebrow", "label": "Grid eyebrow (offers)", "default": "Active offers" },
    { "type": "text", "id": "offers_title", "label": "Grid heading (offers)", "default": "On offer right now" },
    { "type": "text", "id": "cta_title", "label": "Bottom CTA heading", "default": "Not sure where to start? Just ask." },
    { "type": "text", "id": "cta_label", "label": "Bottom CTA button label", "default": "Ask on WhatsApp" }
  ]
}
{% endschema %}
