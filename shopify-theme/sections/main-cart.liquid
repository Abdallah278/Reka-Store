{%- comment -%}
  Cart → official Shopify checkout. The customer reviews the order here and
  hits Checkout; address + governorate are collected by Shopify checkout, the
  order is completed with the store's manual payment method (Vodafone Cash /
  InstaPay transfer) and lands in Shopify admin as Payment pending. WhatsApp
  is for questions and for confirming the transfer after checkout.
{%- endcomment -%}
{%- assign wa = settings.whatsapp_number | default: '201000000000' -%}
{%- assign free_above = settings.free_shipping_threshold | default: '' | strip -%}

{%- if cart.item_count == 0 -%}
<div class="rk-cart-empty" data-cart-empty>
  <span class="rk-cart-empty__icon">{% render 'icon', name: 'shopping-bag', class: 'icon-lg icon' %}</span>
  {%- assign d_et = 'cartx.empty_title' | t -%}{%- assign d_ex = 'cartx.empty_text' | t -%}{%- assign d_eb = 'cartx.empty_btn' | t -%}
  <h1 class="font-display">{{ section.settings.empty_title | default: d_et }}</h1>
  <p>{{ section.settings.empty_text | default: d_ex }}</p>
  <a href="{{ routes.root_url }}" class="btn-ink">{{ section.settings.empty_button | default: d_eb }}</a>
</div>
{%- else -%}
<div class="container rk-cart" data-cart-root>
  {%- assign d_t = 'cartx.title' | t -%}{%- assign d_l = 'cartx.lede' | t -%}
  <h1 class="font-display">{{ section.settings.step1_title | default: d_t }}</h1>
  <p class="rk-cart__lede">{{ section.settings.step1_lede | default: d_l }}</p>

  <div class="rk-cart__grid">
    <ul class="rk-lines" aria-label="Order items">
      {%- for item in cart.items -%}
      <li class="rk-line" data-line="{{ forloop.index }}">
        <a href="{{ item.url }}" class="rk-line__img" aria-label="Open {{ item.product.title | escape }}">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.product.title | escape }}" width="{{ item.image.width }}" height="{{ item.image.height }}">
          {%- else -%}
            {% render 'product-art', product: item.product %}
          {%- endif -%}
        </a>
        <div class="rk-line__body">
          <div class="rk-line__top">
            <div style="min-width:0;">
              <h2 class="rk-line__name"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
              <p class="rk-line__each">{{ item.price | money_without_currency | remove: '.00' }} {{ settings.currency_label | default: 'EGP' }} {{ 'shared.each' | t }}</p>
            </div>
            <p class="rk-line__total">{{ item.line_price | money_without_currency | remove: '.00' }} {{ settings.currency_label | default: 'EGP' }}</p>
          </div>
          <div class="rk-line__controls">
            <div class="rk-qty" role="group" aria-label="Quantity for {{ item.product.title | escape }}">
              <button type="button" aria-label="Decrease quantity" data-qty-minus data-line-index="{{ forloop.index }}">{% render 'icon', name: 'minus' %}</button>
              <span aria-live="polite">{{ item.quantity }}</span>
              <button type="button" aria-label="Increase quantity" data-qty-plus data-line-index="{{ forloop.index }}" {% if item.quantity >= 20 %}disabled{% endif %}>{% render 'icon', name: 'plus' %}</button>
            </div>
            <button type="button" class="rk-line__remove" aria-label="Remove {{ item.product.title | escape }}" data-remove data-line-index="{{ forloop.index }}">
              {% render 'icon', name: 'trash' %} {{ 'shared.remove' | t }}
            </button>
          </div>
        </div>
      </li>
      {%- endfor -%}
    </ul>

    <aside class="rk-summary" aria-label="Order summary">
      {%- assign d_s = 'cartx.summary' | t -%}
      <h2 class="font-display">{{ section.settings.summary_title | default: d_s }}</h2>
      <dl>
        <div><dt>{{ 'shared.subtotal' | t }}</dt><dd>{{ cart.total_price | money_without_currency | remove: '.00' }} {{ settings.currency_label | default: 'EGP' }}</dd></div>
        {%- assign d_dl = 'cartx.delivery_line' | t -%}
        <div><dt>{{ 'shared.delivery' | t }}</dt><dd>{{ section.settings.delivery_line | default: d_dl }}</dd></div>
        {%- if free_above != '' -%}
          {%- assign curx = settings.currency_label | default: 'EGP' -%}
          <div><dt></dt><dd style="font-size:.75rem;">{{ 'cartx.free_above' | t: amount: free_above, cur: curx }}</dd></div>
        {%- endif -%}
        <div class="rk-summary__total"><dt>{{ 'shared.total' | t }}</dt><dd>{{ cart.total_price | money_without_currency | remove: '.00' }} {{ settings.currency_label | default: 'EGP' }} + {{ 'shared.delivery' | t }}</dd></div>
      </dl>

      <form action="{{ routes.cart_url }}" method="post">
        {%- assign d_co = 'cartx.checkout' | t -%}
        <button type="submit" name="checkout" class="rk-summary__cta">
          {{ section.settings.checkout_label | default: d_co }} {% render 'icon', name: 'arrow-right' %}
        </button>
      </form>

      {%- if settings.vodafone_cash != blank or settings.instapay != blank or settings.payment_note != blank -%}
        <div class="rk-paynote" style="margin-top:.875rem; border-radius:1rem; background: color-mix(in srgb, var(--cream) 70%, transparent); padding:.875rem 1rem; font-size:.8125rem; line-height:1.8; color:var(--olive); outline:1px solid color-mix(in srgb, var(--ink) 8%, transparent);">
          {%- assign d_pt = 'cartx.pay_title' | t -%}
          <strong style="color:var(--ink);">{{ section.settings.payment_title | default: d_pt }}</strong><br>
          {%- if settings.vodafone_cash != blank -%}Vodafone Cash: <strong>{{ settings.vodafone_cash }}</strong><br>{%- endif -%}
          {%- if settings.instapay != blank -%}InstaPay: <strong>{{ settings.instapay }}</strong><br>{%- endif -%}
          {%- if settings.payment_note != blank -%}{{ settings.payment_note }}{%- endif -%}
        </div>
      {%- endif -%}

      {%- assign d_note = 'cartx.note' | t -%}
      <p class="rk-summary__note">{{ section.settings.summary_note | default: d_note }}</p>

      {%- assign wa_prefill = section.settings.wa_prefill | default: 'Hi {store}, I have a question about my order.' | replace: '{store}', settings.store_name -%}
      <a href="https://wa.me/{{ wa }}?text={{ wa_prefill | url_encode }}" target="_blank" rel="noopener noreferrer" class="btn-outline btn-block" style="margin-top:.75rem;">
        {%- assign d_wa = 'cartx.wa' | t -%}
        {% render 'icon', name: 'message-circle' %} {{ section.settings.wa_label | default: d_wa }}
      </a>
    </aside>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Cart & checkout",
  "settings": [
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "empty_button",
      "label": "Button label"
    },
    {
      "type": "header",
      "content": "Cart"
    },
    {
      "type": "text",
      "id": "step1_title",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "step1_lede",
      "label": "Intro text"
    },
    {
      "type": "text",
      "id": "summary_title",
      "label": "Summary heading"
    },
    {
      "type": "text",
      "id": "delivery_line",
      "label": "Delivery line in summary"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label"
    },
    {
      "type": "text",
      "id": "payment_title",
      "label": "Transfer box title (numbers: Theme settings → Payment)"
    },
    {
      "type": "textarea",
      "id": "summary_note",
      "label": "Note under the button"
    },
    {
      "type": "text",
      "id": "wa_label",
      "label": "WhatsApp button label"
    },
    {
      "type": "text",
      "id": "wa_prefill",
      "label": "Pre-filled WhatsApp message ({store} = store name)",
      "default": "Hi {store}, I have a question about my order."
    }
  ]
}
{% endschema %}
