{%- comment -%} How ordering works — port of Home.tsx HowItWorks {%- endcomment -%}
{%- assign wa = settings.whatsapp_number | default: '201000000000' -%}
<section class="container rk-section" aria-labelledby="how-title">
  {%- assign d_e = 'home.how_eyebrow' | t -%}{%- assign d_t = 'home.how_title' | t -%}{%- assign d_i = 'home.how_intro' | t -%}
  <div class="rk-section-head">
    <p class="eyebrow text-burgundy">{{ section.settings.eyebrow | default: d_e }}</p>
    <h2 id="how-title" class="font-display">{{ section.settings.title | default: d_t }}</h2>
    <p>{{ section.settings.intro | default: d_i }}</p>
  </div>
  <ol class="rk-steps">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <li class="rk-step" {{ block.shopify_attributes }}>
          <div class="rk-step__top"><span class="rk-step__icon">{% render 'icon', name: block.settings.icon, class: 'icon-lg icon' %}</span><span class="rk-step__n font-display">{{ forloop.index | prepend: '0' }}</span></div>
          <h3 class="font-display">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    {%- else -%}
      <li class="rk-step">
        <div class="rk-step__top"><span class="rk-step__icon">{% render 'icon', name: 'shield-check', class: 'icon-lg icon' %}</span><span class="rk-step__n font-display">01</span></div>
        <h3 class="font-display">{{ 'home.s1t' | t }}</h3>
        <p>{{ 'home.s1x' | t }}</p>
      </li>
      <li class="rk-step">
        <div class="rk-step__top"><span class="rk-step__icon">{% render 'icon', name: 'message-circle', class: 'icon-lg icon' %}</span><span class="rk-step__n font-display">02</span></div>
        <h3 class="font-display">{{ 'home.s2t' | t }}</h3>
        <p>{{ 'home.s2x' | t }}</p>
      </li>
      <li class="rk-step">
        <div class="rk-step__top"><span class="rk-step__icon">{% render 'icon', name: 'truck', class: 'icon-lg icon' %}</span><span class="rk-step__n font-display">03</span></div>
        <h3 class="font-display">{{ 'home.s3t' | t }}</h3>
        <p>{{ 'home.s3x' | t }}</p>
      </li>
    {%- endif -%}
  </ol>
  {%- assign question_prefill = section.settings.question_prefill | default: 'Hi {store}, I have a question before ordering.' | replace: '{store}', settings.store_name -%}
  {%- assign d_n = 'home.how_note' | t -%}{%- assign d_l = 'home.how_link' | t -%}
  <p class="rk-how__note">{{ section.settings.note_prefix | default: d_n }} <a href="https://wa.me/{{ wa }}?text={{ question_prefill | url_encode }}" target="_blank" rel="noopener noreferrer">{{ section.settings.note_link_label | default: d_l }}</a>.</p>
</section>

{% schema %}
{
  "name": "Reka how it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Ordering is a conversation" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "There is no online payment here — by design. Every order is confirmed personally on WhatsApp." },
    { "type": "text", "id": "note_prefix", "label": "Bottom note text", "default": "Questions first?" },
    { "type": "text", "id": "note_link_label", "label": "Bottom note link label", "default": "Message us on WhatsApp" },
    { "type": "text", "id": "question_prefill", "label": "Pre-filled WhatsApp question ({store} = store name)", "default": "Hi {store}, I have a question before ordering." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield-check",
          "options": [
            { "value": "shield-check", "label": "Shield" },
            { "value": "message-circle", "label": "Chat bubble" },
            { "value": "truck", "label": "Truck" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "shopping-bag", "label": "Shopping bag" }
          ]
        },
        { "type": "text", "id": "title", "label": "Step title", "default": "Build your order" },
        { "type": "textarea", "id": "text", "label": "Step text", "default": "Add pieces to your cart and share your delivery details." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Reka how it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "shield-check", "title": "Build your order", "text": "Add pieces to your cart and share your delivery details. Nothing is charged on this site." } },
        { "type": "step", "settings": { "icon": "message-circle", "title": "Confirm on WhatsApp", "text": "Your order opens as a ready message — press send and we confirm availability in chat." } },
        { "type": "step", "settings": { "icon": "truck", "title": "Transfer, then delivery", "text": "We send payment-transfer instructions manually. Once received, your order ships." } }
      ]
    }
  ]
}
{% endschema %}
