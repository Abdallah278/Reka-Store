{%- comment -%} Manifesto marquee — port of Home.tsx Manifesto (compact) {%- endcomment -%}
{%- assign d_marquee = 'home.marquee' | t -%}
{%- assign marquee_raw = section.settings.marquee_items | default: d_marquee -%}
{%- assign marquee_items = marquee_raw | newline_to_br | split: '<br />' -%}
<section class="rk-manifesto">
  <div class="rk-marquee-band" aria-hidden="true">
    <div class="marquee">
      {%- for pass in (1..2) -%}
        {%- for item in marquee_items -%}
          {%- assign t = item | strip -%}
          {%- if t != blank -%}<span>{{ t }} <i></i></span>{%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="container rk-manifesto__grid">
    <div>
      {%- assign d_e = 'home.man_eyebrow' | t -%}{%- assign d_t1 = 'home.man_t1' | t -%}{%- assign d_em = 'home.man_em' | t -%}
      {%- assign shop_n = settings.store_name | default: 'Reka Store' -%}
      {%- assign default_text = 'home.man_text' | t: shop: shop_n -%}
      <p class="eyebrow" style="color: color-mix(in srgb, var(--canvas) 60%, transparent);">{{ section.settings.eyebrow | default: d_e }}</p>
      <h2 class="font-display">{{ section.settings.title_start | default: d_t1 }} <em>{{ section.settings.title_em | default: d_em }}</em></h2>
      <p class="rk-manifesto__text">{{ section.settings.text | default: default_text }}</p>
    </div>
    <div class="rk-manifesto__art">
      <div class="rk-manifesto__art-frame">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" style="height:100%; width:100%; object-fit:cover;">
        {%- else -%}
          {% render 'art', key: 'hands', title: 'Illustration of a hand holding a serum bottle in warm light' %}
        {%- endif -%}
      </div>
      <div class="rk-manifesto__dot" aria-hidden="true"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reka manifesto",
  "settings": [
    {
      "type": "textarea",
      "id": "marquee_items",
      "label": "Scrolling band words (one per line)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title_start",
      "label": "Heading — first part"
    },
    {
      "type": "text",
      "id": "title_em",
      "label": "Heading — italic part"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph (empty = built-in text)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (replaces the illustration)"
    }
  ],
  "presets": [
    {
      "name": "Reka manifesto"
    }
  ]
}
{% endschema %}
