{%- comment -%} Announcement bar — thin strip above the header {%- endcomment -%}
{%- if section.settings.text != blank -%}
<div class="rk-announce" style="background: {{ section.settings.bg | default: '#310e10' }}; color: {{ section.settings.fg | default: '#fbf4d6' }};">
  <div class="container" style="display:flex; align-items:center; justify-content:center; gap:.5rem; min-height:2.25rem; padding-block:.375rem; text-align:center; font-size:.8125rem; font-weight:600; letter-spacing:.02em;">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="color:inherit; text-decoration:none;">{{ section.settings.text }}</a>
    {%- else -%}
      <span>{{ section.settings.text }}</span>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Announcement text (empty = hidden)" },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#310e10" },
    { "type": "color", "id": "fg", "label": "Text color", "default": "#fbf4d6" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
