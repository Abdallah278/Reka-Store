{%- comment -%} Featured edit — port of Home.tsx Featured (real Shopify products) {%- endcomment -%}
{%- assign fc = collections[section.settings.collection] -%}
{%- if fc != blank and fc.products_count > 0 -%}
<section class="rk-section" style="background: color-mix(in srgb, var(--cream) 60%, transparent);" aria-labelledby="featured-title">
  <div class="container">
    <div class="rk-split">
      {%- assign d_e = 'home.feat_eyebrow' | t -%}{%- assign d_t = 'home.feat_title' | t -%}{%- assign d_b = 'home.feat_btn' | t -%}
      <div class="rk-section-head">
        <p class="eyebrow text-burgundy">{{ section.settings.eyebrow | default: d_e }}</p>
        <h2 id="featured-title" class="font-display">{{ section.settings.title | default: d_t }}</h2>
      </div>
      {%- assign btn_link = section.settings.button_link -%}
      {%- if btn_link == blank -%}{%- assign btn_link = routes.collections_url | append: '/makeup' -%}{%- endif -%}
      <a href="{{ btn_link }}" class="btn-outline">{{ section.settings.button_label | default: d_b }}</a>
    </div>
    <ul class="rk-grid-products">
      {%- for product in fc.products limit: section.settings.limit -%}
        <li>{% render 'product-card', product: product, show_department: true %}</li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Reka featured edit",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "This week" },
    { "type": "text", "id": "title", "label": "Heading", "default": "The featured edit" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Browse departments" },
    { "type": "url", "id": "button_link", "label": "Button link (empty = makeup collection)" },
    { "type": "collection", "id": "collection", "label": "Collection to feature" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Reka featured edit" }]
}
{% endschema %}
