{%- comment -%} Footer — port of chrome.tsx Footer {%- endcomment -%}
{%- assign wa = settings.whatsapp_number | default: '201000000000' -%}
<footer id="contact" class="rk-footer">
  <div class="container rk-footer__grid">
    <div>
      <p class="rk-footer__name font-display">{{ settings.store_name | default: 'Reka Store' }}</p>
      {%- assign d_about = 'home.foot_about' | t -%}
      <p class="rk-footer__about">{{ section.settings.about | default: d_about }}</p>
    </div>
    <nav aria-label="Departments" class="rk-footer__nav">
      {%- assign menu = linklists[section.settings.menu] -%}
      {%- if menu != blank and menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.collections_url }}/korean-skincare">{{ 'depts.korean.name' | t }}</a>
        <a href="{{ routes.collections_url }}/french-skincare">{{ 'depts.french.name' | t }}</a>
        <a href="{{ routes.collections_url }}/makeup">{{ 'depts.makeup.name' | t }}</a>
        <a href="{{ routes.collections_url }}/perfumes">{{ 'depts.perfumes.name' | t }}</a>
        <a href="{{ routes.collections_url }}/offers">{{ 'depts.offers.name' | t }}</a>
      {%- endif -%}
      {%- assign d_ship = 'home.foot_ship' | t -%}{%- assign d_cart = 'shared.cart' | t -%}
      {%- if pages.shipping.url != blank -%}<a href="{{ pages.shipping.url }}">{{ section.settings.shipping_label | default: d_ship }}</a>{%- endif -%}
      <a href="{{ routes.cart_url }}">{{ section.settings.cart_label | default: d_cart }}</a>
    </nav>
    <nav aria-label="Contact" class="rk-footer__contact">
      {%- assign wa_link = settings.whatsapp_page_url | default: '' -%}
      {%- if wa_link == blank -%}{%- assign wa_link = 'https://wa.me/' | append: wa -%}{%- endif -%}
      <a class="rk-social" href="{{ wa_link }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
        <span class="rk-social__ic rk-social__ic--wa">{% render 'icon', name: 'message-circle', class: 'icon-lg icon' %}</span>
        <span>WhatsApp</span>
      </a>
      {%- if settings.instagram_url != blank -%}
        <a class="rk-social" href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <span class="rk-social__ic">{% render 'icon', name: 'instagram', class: 'icon-lg icon' %}</span>
          <span>Instagram</span>
        </a>
      {%- endif -%}
      {%- if settings.facebook_url != blank -%}
        <a class="rk-social" href="{{ settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <span class="rk-social__ic">{% render 'icon', name: 'facebook', class: 'icon-lg icon' %}</span>
          <span>Facebook</span>
        </a>
      {%- endif -%}
      {%- if settings.tiktok_url != blank -%}
        <a class="rk-social" href="{{ settings.tiktok_url }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <span class="rk-social__ic">{% render 'icon', name: 'tiktok', class: 'icon-lg icon' %}</span>
          <span>TikTok</span>
        </a>
      {%- endif -%}
    </nav>
  </div>
  <div class="container rk-footer__legal" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem;">
    {%- assign d_legal = 'home.foot_legal' | t -%}
    <span>© {{ 'now' | date: '%Y' }} {{ settings.store_name | default: 'Reka Store' }}. {{ section.settings.legal | default: d_legal }}</span>
    {%- if localization.available_languages.size > 1 -%}
      {%- form 'localization' -%}
        <select name="locale_code" onchange="this.form.submit()" aria-label="Language" style="min-height:2.5rem; border-radius:9999px; border:1px solid color-mix(in srgb, var(--ink) 20%, transparent); background:var(--cream); padding-inline:1rem; font-size:.8125rem; font-weight:600; color:var(--ink);">
          {%- for language in localization.available_languages -%}
            <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
          {%- endfor -%}
        </select>
      {%- endform -%}
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Reka footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about",
      "label": "About text"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu (empty = built-in five departments)"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping page link label"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart link label"
    },
    {
      "type": "text",
      "id": "legal",
      "label": "Legal line (after the © year)"
    }
  ]
}
{% endschema %}
