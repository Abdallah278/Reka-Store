{%- comment -%} Footer — port of chrome.tsx Footer {%- endcomment -%}
{%- assign wa = settings.whatsapp_number | default: '201000000000' -%}
<footer id="contact" class="rk-footer">
  <div class="container rk-footer__grid">
    <div>
      <p class="rk-footer__name font-display">{{ settings.store_name | default: 'Reka Store' }}</p>
      <p class="rk-footer__about">{{ section.settings.about | default: "A women's beauty edit across five departments. Prices in EGP. Orders are confirmed on WhatsApp and payment instructions are sent manually — no online payment happens on this site." }}</p>
    </div>
    <nav aria-label="Departments" class="rk-footer__nav">
      {%- assign menu = linklists[section.settings.menu] -%}
      {%- if menu != blank and menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.collections_url }}/korean-skincare">Korean Skincare</a>
        <a href="{{ routes.collections_url }}/french-skincare">French Skincare</a>
        <a href="{{ routes.collections_url }}/makeup">Makeup</a>
        <a href="{{ routes.collections_url }}/perfumes">Perfumes</a>
        <a href="{{ routes.collections_url }}/offers">Offers</a>
      {%- endif -%}
      {%- if pages.shipping.url != blank -%}<a href="{{ pages.shipping.url }}">{{ section.settings.shipping_label | default: 'Shipping & delivery' }}</a>{%- endif -%}
      <a href="{{ routes.cart_url }}">{{ section.settings.cart_label | default: 'Cart' }}</a>
    </nav>
    <nav aria-label="Contact" class="rk-footer__contact">
      {%- assign wa_link = settings.whatsapp_page_url | default: '' -%}
      {%- if wa_link == blank -%}{%- assign wa_link = 'https://wa.me/' | append: wa -%}{%- endif -%}
      <a href="{{ wa_link }}" target="_blank" rel="noopener noreferrer">{% render 'icon', name: 'message-circle' %} WhatsApp</a>
      {%- if settings.instagram_url != blank -%}
        <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer">{% render 'icon', name: 'instagram' %} Instagram</a>
      {%- endif -%}
      {%- if settings.facebook_url != blank -%}
        <a href="{{ settings.facebook_url }}" target="_blank" rel="noopener noreferrer">{% render 'icon', name: 'facebook' %} Facebook</a>
      {%- endif -%}
      {%- if settings.tiktok_url != blank -%}
        <a href="{{ settings.tiktok_url }}" target="_blank" rel="noopener noreferrer">{% render 'icon', name: 'tiktok' %} TikTok</a>
      {%- endif -%}
    </nav>
  </div>
  <div class="container rk-footer__legal">© {{ 'now' | date: '%Y' }} {{ settings.store_name | default: 'Reka Store' }}. {{ section.settings.legal | default: 'Illustrations are original brand artwork.' }}</div>
</footer>

{% schema %}
{
  "name": "Reka footer",
  "settings": [
    { "type": "textarea", "id": "about", "label": "About text", "default": "A women's beauty edit across five departments. Prices in EGP. Orders are confirmed on WhatsApp and payment instructions are sent manually — no online payment happens on this site." },
    { "type": "link_list", "id": "menu", "label": "Footer menu (empty = built-in five departments)" },
    { "type": "text", "id": "shipping_label", "label": "Shipping page link label", "default": "Shipping & delivery" },
    { "type": "text", "id": "cart_label", "label": "Cart link label", "default": "Cart" },
    { "type": "text", "id": "legal", "label": "Legal line (after the © year)", "default": "Illustrations are original brand artwork." }
  ]
}
{% endschema %}
