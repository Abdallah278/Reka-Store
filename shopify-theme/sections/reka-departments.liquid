{%- comment -%} Five department gateways — port of Home.tsx Gateways {%- endcomment -%}
<section id="departments" class="container rk-section" aria-labelledby="departments-title" style="scroll-margin-top:6rem;">
  <div class="rk-split">
    <div class="rk-section-head">
      <p class="eyebrow text-burgundy">{{ section.settings.eyebrow | default: 'Choose your ritual' }}</p>
      <h2 id="departments-title" class="font-display">{{ section.settings.title | default: 'Five departments, five moods' }}</h2>
    </div>
    <p>{{ section.settings.intro | default: 'Each department is its own room — its own light, colour and pace. Step into the one closest to today.' }}</p>
  </div>
  <div class="rk-depts">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign i = forloop.index0 -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- assign n = forloop.index | prepend: '0' -%}
        {%- assign url = block.settings.link -%}
        {%- if url == blank and col != blank -%}{%- assign url = col.url -%}{%- endif -%}
        {%- assign dept_name = block.settings.name -%}
        {%- if dept_name == blank and col != blank -%}{%- assign dept_name = col.title -%}{%- endif -%}
        <a href="{{ url | default: routes.collections_url }}" class="rk-dept {% if i < 2 %}rk-dept--wide{% else %}rk-dept--narrow{% endif %}" aria-label="Enter {{ dept_name | escape }}" {{ block.shopify_attributes }}>
          <div class="rk-dept__art" style="background: linear-gradient(160deg, {{ block.settings.grad_start }} 0%, {{ block.settings.grad_end }} 80%);">
            <div class="rk-dept__art-inner">
              {%- if block.settings.image -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}" alt="" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" style="height:100%; width:100%; object-fit:cover;">
              {%- else -%}
                {% render 'art', key: block.settings.art, title: dept_name %}
              {%- endif -%}
            </div>
          </div>
          <div class="rk-dept__meta">
            <div>
              <p class="eyebrow">{{ n }}</p>
              <p class="rk-dept__name font-display">{{ dept_name }}</p>
              <p class="rk-dept__count">
                {%- if col != blank and col.products_count > 0 -%}
                  {{ col.products_count }} piece{% if col.products_count != 1 %}s{% endif %}
                {%- else -%}
                  {{ block.settings.tagline }}
                {%- endif -%}
              </p>
            </div>
            <span class="rk-dept__arrow">{% render 'icon', name: 'arrow-up-right' %}</span>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- assign handles = 'korean-skincare,french-skincare,makeup,perfumes,offers' | split: ',' -%}
      {%- assign dept_keys = 'korean,french,makeup,perfumes,offers' | split: ',' -%}
      {%- capture names_c -%}{%- for dk in dept_keys -%}{%- assign nk = 'depts.' | append: dk | append: '.name' -%}{{ nk | t }}{%- unless forloop.last -%}||{%- endunless -%}{%- endfor -%}{%- endcapture -%}
      {%- assign names = names_c | split: '||' -%}
      {%- capture tags_c -%}{%- for dk in dept_keys -%}{%- assign nk = 'depts.' | append: dk | append: '.tagline' -%}{{ nk | t }}{%- unless forloop.last -%}||{%- endunless -%}{%- endfor -%}{%- endcapture -%}
      {%- assign taglines = tags_c | split: '||' -%}
      {%- assign grads = 'linear-gradient(160deg. #74070E 0%. #310E10 78%)|linear-gradient(160deg. #F4E3B2 0%. #fbf4d6 70%)|linear-gradient(160deg. #45462A 0%. #310E10 80%)|linear-gradient(160deg. #947268 0%. #310E10 85%)|linear-gradient(165deg. #310E10 0%. #74070E 130%)' | split: '|' -%}
      {%- for h in handles -%}
        {%- assign i = forloop.index0 -%}
        {%- assign col = collections[h] -%}
        {%- assign n = forloop.index | prepend: '0' -%}
        {%- assign grad = grads[i] | replace: '.', ',' -%}
        <a href="{{ routes.collections_url }}/{{ h }}" class="rk-dept {% if i < 2 %}rk-dept--wide{% else %}rk-dept--narrow{% endif %}" aria-label="Enter {{ names[i] }}">
          <div class="rk-dept__art" style="background: {{ grad }};">
            <div class="rk-dept__art-inner">
              <img src="{{ 'dept-' | append: h | append: '.jpg' | asset_url }}" alt="{{ names[i] }}" loading="lazy" width="900" height="700" style="height:100%; width:100%; object-fit:cover;">
            </div>
          </div>
          <div class="rk-dept__meta">
            <div>
              <p class="eyebrow">{{ n }}</p>
              <p class="rk-dept__name font-display">{{ names[i] }}</p>
              <p class="rk-dept__count">
                {%- if col != blank and col.products_count > 0 -%}
                  {%- if col.products_count == 1 -%}{{ 'shared.piece' | t: count: col.products_count }}{%- else -%}{{ 'shared.pieces' | t: count: col.products_count }}{%- endif -%}
                {%- else -%}
                  {{ taglines[i] }}
                {%- endif -%}
              </p>
            </div>
            <span class="rk-dept__arrow">{% render 'icon', name: 'arrow-up-right' %}</span>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reka departments",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Choose your ritual" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Five departments, five moods" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Each department is its own room — its own light, colour and pace. Step into the one closest to today." },
    { "type": "paragraph", "content": "Add \"Department\" blocks to control the cards. With no blocks, the built-in five departments are shown." }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "name", "label": "Display name (empty = collection title)" },
        { "type": "text", "id": "tagline", "label": "Tagline (shown when the collection is empty)" },
        { "type": "url", "id": "link", "label": "Link (empty = the collection)" },
        { "type": "image_picker", "id": "image", "label": "Card image (replaces the illustration)" },
        {
          "type": "select",
          "id": "art",
          "label": "Illustration (used when no image)",
          "default": "serum-bottle",
          "options": [
            { "value": "serum-bottle", "label": "Serum bottle" },
            { "value": "cream-jar", "label": "Cream jar" },
            { "value": "lipstick-bullet", "label": "Lipstick" },
            { "value": "perfume-bottle", "label": "Perfume bottle" },
            { "value": "offer-mark", "label": "Offer mark" }
          ]
        },
        { "type": "color", "id": "grad_start", "label": "Card gradient — start", "default": "#74070E" },
        { "type": "color", "id": "grad_end", "label": "Card gradient — end", "default": "#310E10" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Reka departments" }]
}
{% endschema %}
